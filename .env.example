# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.

# Feature flag: set to true to enable the "Ask my avatar" chat feature (Phase 4)
# This also requires the Netlify Function + API key below.
VITE_ENABLE_CHAT=false

# Only needed if VITE_ENABLE_CHAT=true.
# Set this in Netlify Dashboard → Site Settings → Environment Variables.
# NEVER put this in client-side code or commit it to git.
# OPENAI_API_KEY=sk-...
